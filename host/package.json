{
  "name": "@lightwebinc/bfinger-host",
  "version": "0.3.5",
  "private": true,
  "description": "tm_finger and ls_finger: the committed-record topic manager and lookup service, loaded into the reference overlay host as a module",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "bundle": "node scripts/bundle.js",
    "check": "tsc --noEmit",
    "pretest": "npm run build && npm run bundle",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@bsv/sdk": "2.7.1",
    "@lightwebinc/bcommon": "file:vendor/lightwebinc-bcommon-0.5.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
